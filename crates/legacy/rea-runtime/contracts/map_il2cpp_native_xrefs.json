{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "map_il2cpp_native_xrefs",
  "title": "Map IL2CPP Native Cross References",
  "description": "Correlate caller-supplied native cross-reference rows with IL2CPP method-address rows using exact lowercase SHA-256, address-space, and target-address identity. The projection is bounded, read-only, captured-only, and preserves mapped, ambiguous, unknown, and unmapped outcomes.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/input"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/output"
  },
  "readOnlyHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "row": {
      "type": "object",
      "additionalProperties": true
    },
    "methodRow": {
      "allOf": [
        {
          "$ref": "#/$defs/row"
        },
        {
          "allOf": [
            {
              "anyOf": [
                {"required": ["binary_sha256"]},
                {"required": ["artifact_sha256"]},
                {"required": ["sha256"]}
              ]
            },
            {
              "anyOf": [
                {"required": ["address_space"]},
                {"required": ["space"]}
              ]
            },
            {
              "anyOf": [
                {"required": ["start_address"]},
                {"required": ["address"]},
                {"required": ["method_pointer"]}
              ]
            }
          ],
          "properties": {
            "binary_sha256": {"$ref": "#/$defs/sha256"},
            "artifact_sha256": {"$ref": "#/$defs/sha256"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "address_space": {"$ref": "#/$defs/text"},
            "space": {"$ref": "#/$defs/text"},
            "start_address": {"$ref": "#/$defs/text"},
            "address": {"$ref": "#/$defs/text"},
            "method_pointer": {"$ref": "#/$defs/text"}
          }
        }
      ]
    },
    "xrefRow": {
      "allOf": [
        {
          "$ref": "#/$defs/row"
        },
        {
          "allOf": [
            {
              "anyOf": [
                {"required": ["binary_sha256"]},
                {"required": ["artifact_sha256"]},
                {"required": ["sha256"]}
              ]
            },
            {
              "anyOf": [
                {"required": ["address_space"]},
                {"required": ["space"]}
              ]
            },
            {
              "anyOf": [
                {"required": ["target_address"]},
                {"required": ["target"]},
                {"required": ["to"]}
              ]
            },
            {
              "anyOf": [
                {"required": ["source_address"]},
                {"required": ["source"]},
                {"required": ["from"]}
              ]
            }
          ],
          "properties": {
            "binary_sha256": {"$ref": "#/$defs/sha256"},
            "artifact_sha256": {"$ref": "#/$defs/sha256"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "address_space": {"$ref": "#/$defs/text"},
            "space": {"$ref": "#/$defs/text"},
            "target_address": {"$ref": "#/$defs/text"},
            "target": {"$ref": "#/$defs/text"},
            "to": {"$ref": "#/$defs/text"},
            "source_address": {"$ref": "#/$defs/text"},
            "source": {"$ref": "#/$defs/text"},
            "from": {"$ref": "#/$defs/text"}
          }
        }
      ]
    },
    "methodRows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": {"$ref": "#/$defs/methodRow"}
    },
    "xrefRows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": {"$ref": "#/$defs/xrefRow"}
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "methods": {"$ref": "#/$defs/methodRows"},
        "method_addresses": {"$ref": "#/$defs/methodRows"},
        "mappings": {"$ref": "#/$defs/methodRows"},
        "xrefs": {"$ref": "#/$defs/xrefRows"},
        "native_xrefs": {"$ref": "#/$defs/xrefRows"},
        "call_references": {"$ref": "#/$defs/xrefRows"}
      },
      "allOf": [
        {
          "anyOf": [
            {"required": ["methods"]},
            {"required": ["method_addresses"]},
            {"required": ["mappings"]}
          ]
        },
        {
          "anyOf": [
            {"required": ["xrefs"]},
            {"required": ["native_xrefs"]},
            {"required": ["call_references"]}
          ]
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["method", "status", "xrefs"],
      "properties": {
        "method": {"type": "object", "additionalProperties": true},
        "status": {"enum": ["mapped", "ambiguous", "unknown", "unmapped"]},
        "xrefs": {"type": "array", "maxItems": 200000, "items": {"$ref": "#/$defs/xrefRow"}},
        "unknowns": {"type": "array", "items": {"type": "string", "maxLength": 1024}}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["method_rows", "xref_rows", "mapped", "ambiguous", "unknown", "unmapped", "unresolved_xref_targets"],
      "properties": {
        "method_rows": {"type": "integer", "minimum": 0},
        "xref_rows": {"type": "integer", "minimum": 0},
        "mapped": {"type": "integer", "minimum": 0},
        "ambiguous": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "unmapped": {"type": "integer", "minimum": 0},
        "unresolved_xref_targets": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["status", "items", "coverage", "limitations"],
      "properties": {
        "status": {"enum": ["complete", "partial"]},
        "items": {"type": "array", "maxItems": 200000, "items": {"$ref": "#/$defs/item"}},
        "coverage": {"$ref": "#/$defs/coverage"},
        "limitations": {"type": "array", "items": {"type": "string", "maxLength": 1024}}
      },
      "additionalProperties": false
    }
  }
}
