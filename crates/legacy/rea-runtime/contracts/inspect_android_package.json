{
  "name": "inspect_android_package",
  "title": "Inspect Android Package",
  "description": "Inspect a selected local APK package manifest and metadata without executing the package.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": { "path": { "type": "string", "minLength": 1 } },
    "required": ["path"]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["result"],
    "properties": {
      "result": {
        "type": "object",
        "required": ["artifact", "package_name", "manifest", "resource_variants", "signing_blocks", "signature_verification", "dex", "components", "features", "supports_screens", "queries", "permission_details", "uses_configuration", "application_label", "limitations"],
        "properties": {
          "artifact": { "type": "object", "required": ["path", "sha256", "bytes"] },
          "package_name": { "type": ["string", "null"] }, "version_name": { "type": ["string", "null"] }, "version_code": { "type": ["string", "null"] },
          "min_sdk": { "type": ["string", "null"] }, "target_sdk": { "type": ["string", "null"] }, "application_label": { "type": ["string", "null"] }, "application_name": { "type": ["string", "null"] }, "application_icon": { "type": ["string", "null"] }, "application_round_icon": { "type": ["string", "null"] },
          "allow_backup": { "type": ["boolean", "null"] }, "extract_native_libs": { "type": ["boolean", "null"] }, "uses_cleartext_traffic": { "type": ["boolean", "null"] }, "debuggable": { "type": ["boolean", "null"] },
          "permissions": { "type": "array", "items": { "type": "string" } }, "permission_details": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/permissionDeclaration" } }, "manifest": { "type": "object" }, "class_count": { "type": "integer", "minimum": 0 }, "resource_count": { "type": "integer", "minimum": 0 }, "signature_verification": { "const": "not_performed" },
          "signing_blocks": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/signingBlock" } }, "resource_variants": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/resourceVariant" } }, "dex": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/dexFacts" } }, "components": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/component" } }, "features": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/usesFeature" } }, "supports_screens": { "$ref": "#/outputSchema/properties/result/$defs/supportsScreens" }, "queries": { "anyOf": [{ "type": "null" }, { "$ref": "#/outputSchema/properties/result/$defs/queryVisibility" }] }, "uses_configuration": { "anyOf": [{ "type": "null" }, { "$ref": "#/outputSchema/properties/result/$defs/usesConfiguration" }] }, "limitations": { "type": "array", "items": { "type": "string" } }
        },
        "$defs": {
          "resourceVariant": { "type": "object", "required": ["resource_id", "configuration", "value", "source_offset"], "properties": { "resource_id": { "type": "string" }, "configuration": { "type": "string" }, "value": { "type": "string" }, "source_offset": { "type": "integer", "minimum": 0 } } },
          "signingBlock": { "type": "object", "required": ["id", "source_offset", "size", "signers", "issues"], "properties": { "id": { "type": "integer", "minimum": 0 }, "source_offset": { "type": "integer", "minimum": 0 }, "size": { "type": "integer", "minimum": 0 }, "signers": { "type": "array", "items": { "type": "object" } }, "issues": { "type": "array", "items": { "type": "string" } } } },
          "dexFacts": { "type": "object", "required": ["entry", "strings", "types", "methods", "classes", "referenced_methods", "class_definitions", "method_code_offsets", "code", "annotations", "call_sites", "method_handles", "truncated"], "properties": { "entry": { "type": "string" }, "strings": { "type": "array", "items": { "type": "string" } }, "types": { "type": "array", "items": { "type": "string" } }, "methods": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/dexMethod" } }, "classes": { "type": "array", "items": { "type": "string" } }, "referenced_methods": { "type": "array", "items": { "type": "string" } }, "class_definitions": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/dexClass" } }, "method_code_offsets": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "code": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/dexMethodCode" } }, "annotations": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/dexAnnotation" } }, "call_sites": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/dexCallSite" } }, "method_handles": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/dexMethodHandle" } }, "truncated": { "type": "boolean" } } },
          "component": { "type": "object", "properties": { "kind": { "type": "string" }, "name": { "type": "string" }, "exported": { "type": ["boolean", "null"] }, "target_activity": { "type": ["string", "null"] }, "enabled": { "type": ["boolean", "null"] }, "permission": { "type": ["string", "null"] }, "process": { "type": ["string", "null"] }, "launch_mode": { "type": ["string", "null"] }, "theme": { "type": ["string", "null"] }, "source_offset": { "type": "integer", "minimum": 0 }, "intent_filter_count": { "type": "integer", "minimum": 0 }, "intent_filters": { "type": "array", "items": { "type": "object" } } } },
          "usesFeature": { "type": "object", "required": ["name", "gl_es_version", "required", "source_offset"], "properties": { "name": { "type": ["string", "null"] }, "gl_es_version": { "type": ["string", "null"] }, "required": { "type": ["boolean", "null"] }, "source_offset": { "type": "integer", "minimum": 0 } } },
          "supportsScreens": { "type": "object", "required": ["small", "normal", "large", "xlarge", "any_density", "source_offset"], "properties": { "small": { "type": ["boolean", "null"] }, "normal": { "type": ["boolean", "null"] }, "large": { "type": ["boolean", "null"] }, "xlarge": { "type": ["boolean", "null"] }, "any_density": { "type": ["boolean", "null"] }, "source_offset": { "type": ["integer", "null"], "minimum": 0 } } },
          "queryVisibility": { "type": "object", "required": ["packages", "providers", "intents", "source_offset"], "properties": { "packages": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/queryPackage" } }, "providers": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/queryProvider" } }, "intents": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/queryIntent" } }, "source_offset": { "type": "integer", "minimum": 0 } } },
          "queryPackage": { "type": "object", "required": ["name", "source_offset"], "properties": { "name": { "type": ["string", "null"] }, "source_offset": { "type": "integer", "minimum": 0 } } },
          "queryProvider": { "type": "object", "required": ["name", "authorities", "source_offset"], "properties": { "name": { "type": ["string", "null"] }, "authorities": { "type": ["string", "null"] }, "source_offset": { "type": "integer", "minimum": 0 } } },
          "queryIntent": { "type": "object", "required": ["actions", "categories", "data_schemes", "mime_types", "data", "source_offset"], "properties": { "actions": { "type": "array", "items": { "type": "string" } }, "categories": { "type": "array", "items": { "type": "string" } }, "data_schemes": { "type": "array", "items": { "type": "string" } }, "mime_types": { "type": "array", "items": { "type": "string" } }, "data": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/queryData" } }, "source_offset": { "type": "integer", "minimum": 0 } } },
          "queryData": { "type": "object", "required": ["scheme", "mime_type", "host", "port", "path", "path_prefix", "path_pattern", "path_advanced_pattern", "path_suffix", "source_offset"], "properties": { "scheme": { "type": ["string", "null"] }, "mime_type": { "type": ["string", "null"] }, "host": { "type": ["string", "null"] }, "port": { "type": ["string", "null"] }, "path": { "type": ["string", "null"] }, "path_prefix": { "type": ["string", "null"] }, "path_pattern": { "type": ["string", "null"] }, "path_advanced_pattern": { "type": ["string", "null"] }, "path_suffix": { "type": ["string", "null"] }, "source_offset": { "type": "integer", "minimum": 0 } } },
          "permissionDeclaration": { "type": "object", "required": ["tag", "name", "max_sdk_version", "max_sdk_value", "uses_permission_flags", "source_offset"], "properties": { "tag": { "type": "string", "enum": ["uses-permission", "uses-permission-sdk-23", "uses-permission-sdk-m"] }, "name": { "type": ["string", "null"] }, "max_sdk_version": { "type": ["string", "null"] }, "max_sdk_value": { "type": ["integer", "null"], "minimum": 0 }, "uses_permission_flags": { "type": ["string", "null"] }, "source_offset": { "type": "integer", "minimum": 0 } } },
          "usesConfiguration": { "type": "object", "required": ["req_keyboard_type", "req_keyboard_type_value", "req_navigation", "req_navigation_value", "req_touchscreen", "req_touchscreen_value", "req_five_way_nav", "req_hard_keyboard", "source_offset"], "properties": { "req_keyboard_type": { "type": ["string", "null"] }, "req_keyboard_type_value": { "type": ["string", "null"] }, "req_navigation": { "type": ["string", "null"] }, "req_navigation_value": { "type": ["string", "null"] }, "req_touchscreen": { "type": ["string", "null"] }, "req_touchscreen_value": { "type": ["string", "null"] }, "req_five_way_nav": { "type": ["boolean", "null"] }, "req_hard_keyboard": { "type": ["boolean", "null"] }, "source_offset": { "type": "integer", "minimum": 0 } } },
          "dexMethod": { "type": "object", "required": ["class_descriptor", "name", "descriptor"], "properties": { "class_descriptor": { "type": "string" }, "name": { "type": "string" }, "descriptor": { "type": "string" } } },
          "dexClass": { "type": "object", "required": ["descriptor", "superclass", "interfaces", "fields", "methods", "static_values"], "properties": { "descriptor": { "type": "string" }, "superclass": { "type": ["string", "null"] }, "interfaces": { "type": "array", "items": { "type": "string" } }, "fields": { "type": "array", "items": { "type": "object" } }, "methods": { "type": "array", "items": { "type": "object" } }, "static_values": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/dexStaticValue" } } } },
          "dexStaticValue": { "type": "object", "required": ["field_index", "source_offset", "value", "issues"], "properties": { "field_index": { "type": "integer", "minimum": 0 }, "source_offset": { "type": "integer", "minimum": 0 }, "value": { "$ref": "#/outputSchema/properties/result/$defs/dexEncodedValue" }, "issues": { "type": "array", "items": { "type": "string" } } } },
          "dexEncodedValue": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string", "enum": ["Integer", "String", "Type", "Boolean", "Null", "Array", "Annotation", "Unsupported"] }, "value": {} } },
          "dexAnnotation": { "type": "object", "required": ["owner", "visibility", "type_descriptor", "elements", "source_offset", "issues"], "properties": { "owner": { "type": "string" }, "visibility": { "type": "string" }, "type_descriptor": { "type": ["string", "null"] }, "elements": { "type": "array", "items": { "type": "object" } }, "source_offset": { "type": "integer", "minimum": 0 }, "issues": { "type": "array", "items": { "type": "string" } } } },
          "dexCallSite": { "type": "object", "required": ["index", "source_offset", "values", "issues"], "properties": { "index": { "type": "integer", "minimum": 0 }, "source_offset": { "type": "integer", "minimum": 0 }, "values": { "type": "array", "items": { "$ref": "#/outputSchema/properties/result/$defs/dexEncodedValue" } }, "issues": { "type": "array", "items": { "type": "string" } } } },
          "dexMethodHandle": { "type": "object", "required": ["index", "source_offset", "kind", "member_index", "target", "issues"], "properties": { "index": { "type": "integer", "minimum": 0 }, "source_offset": { "type": "integer", "minimum": 0 }, "kind": { "type": "string" }, "member_index": { "type": "integer", "minimum": 0 }, "target": { "type": ["string", "null"] }, "issues": { "type": "array", "items": { "type": "string" } } } },
          "dexMethodCode": { "type": "object", "properties": { "method_index": { "type": "integer", "minimum": 0 }, "code_offset": { "type": "integer", "minimum": 0 }, "invokes": { "type": "array" }, "strings": { "type": "array" }, "debug": {}, "issues": { "type": "array", "items": { "type": "string" } } } }
        }
      }
    },
    "additionalProperties": false
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  }
}
