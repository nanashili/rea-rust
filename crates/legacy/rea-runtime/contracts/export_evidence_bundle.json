{
  "name": "export_evidence_bundle",
  "title": "Export Evidence Bundle",
  "description": "Atomically write the session's deterministic Evidence bundle to the requested local path. Existing files require overwrite: true; records and manifests use canonical byte-stable ordering.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\x00]*$",
        "description": "Absolute local filesystem path for the exported evidence bundle; relative paths are rejected."
      },
      "overwrite": {
        "default": false,
        "type": "boolean",
        "description": "Whether an existing destination may be replaced."
      }
    },
    "required": [
      "path"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "examples": [
      {
        "path": "/tmp/evidence.json",
        "overwrite": false
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "required": [
      "result"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "records": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unknowns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "bytes",
          "records",
          "unknowns"
        ],
        "additionalProperties": false
      }
    },
    "$id": "urn:rea:tool-output:sha256:8f25c6189cc54a6a9705844d3b51f53abe7d85c22aebe665040d2fade659c4ed"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
