{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "project_il2cpp_field_layouts",
  "title": "Project IL2CPP Field Layouts",
  "description": "Project caller-supplied IL2CPP type and field metadata with captured native field-layout rows. This read-only, captured-only operation never opens an artifact, attaches to a process, invokes Unity or IL2CPP, executes target code, or mutates a target. Unknown source fields, unresolved owners, missing offsets, inferred sizes, and overlapping ranges remain explicit.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "oneOf": [
      { "$ref": "#/$defs/directInput" },
      { "$ref": "#/$defs/wrappedInput" }
    ],
    "$defs": {
      "index": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "sourceRow": {
        "type": "object",
        "maxProperties": 128,
        "additionalProperties": true
      },
      "typeRows": {
        "type": "array",
        "minItems": 0,
        "maxItems": 200000,
        "items": { "$ref": "#/$defs/sourceRow" }
      },
      "fieldRows": {
        "type": "array",
        "minItems": 0,
        "maxItems": 200000,
        "items": { "$ref": "#/$defs/sourceRow" }
      },
      "layoutRow": {
        "type": "object",
        "maxProperties": 128,
        "properties": {
          "field_index": { "$ref": "#/$defs/index" },
          "metadata_index": { "$ref": "#/$defs/index" },
          "index": { "$ref": "#/$defs/index" },
          "offset": { "$ref": "#/$defs/index" },
          "size": { "$ref": "#/$defs/index" }
        },
        "anyOf": [
          { "required": ["field_index"] },
          { "required": ["metadata_index"] },
          { "required": ["index"] }
        ],
        "additionalProperties": true
      },
      "layoutRows": {
        "type": "array",
        "minItems": 0,
        "maxItems": 200000,
        "items": { "$ref": "#/$defs/layoutRow" }
      },
      "typeTable": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "types": { "$ref": "#/$defs/typeRows" },
          "type_definitions": { "$ref": "#/$defs/typeRows" },
          "fields": { "$ref": "#/$defs/fieldRows" },
          "field_definitions": { "$ref": "#/$defs/fieldRows" }
        },
        "allOf": [
          {
            "anyOf": [
              { "required": ["types"] },
              { "required": ["type_definitions"] }
            ]
          },
          {
            "anyOf": [
              { "required": ["fields"] },
              { "required": ["field_definitions"] }
            ]
          }
        ]
      },
      "layoutTable": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field_layouts": { "$ref": "#/$defs/layoutRows" },
          "field_offsets": { "$ref": "#/$defs/layoutRows" },
          "field_layout_rows": { "$ref": "#/$defs/layoutRows" }
        },
        "anyOf": [
          { "required": ["field_layouts"] },
          { "required": ["field_offsets"] },
          { "required": ["field_layout_rows"] }
        ]
      },
      "directInput": {
        "type": "object",
        "properties": {
          "types": { "$ref": "#/$defs/typeRows" },
          "type_definitions": { "$ref": "#/$defs/typeRows" },
          "fields": { "$ref": "#/$defs/fieldRows" },
          "field_definitions": { "$ref": "#/$defs/fieldRows" },
          "field_layouts": { "$ref": "#/$defs/layoutRows" },
          "field_offsets": { "$ref": "#/$defs/layoutRows" },
          "field_layout_rows": { "$ref": "#/$defs/layoutRows" }
        },
        "allOf": [
          {
            "anyOf": [
              { "required": ["types"] },
              { "required": ["type_definitions"] }
            ]
          },
          {
            "anyOf": [
              { "required": ["fields"] },
              { "required": ["field_definitions"] }
            ]
          },
          {
            "anyOf": [
              { "required": ["field_layouts"] },
              { "required": ["field_offsets"] },
              { "required": ["field_layout_rows"] }
            ]
          }
        ],
        "additionalProperties": false
      },
      "wrappedInput": {
        "type": "object",
        "required": ["metadata", "binary"],
        "properties": {
          "metadata": { "$ref": "#/$defs/typeTable" },
          "binary": { "$ref": "#/$defs/layoutTable" }
        },
        "additionalProperties": false
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["operation", "status", "classes", "sources", "coverage", "diagnostics", "limitations"],
    "properties": {
      "operation": { "const": "project_il2cpp_field_layouts" },
      "status": { "enum": ["complete", "partial"] },
      "classes": {
        "type": "array",
        "maxItems": 200000,
        "items": { "$ref": "#/$defs/classLayout" }
      },
      "sources": { "$ref": "#/$defs/sourceContext" },
      "coverage": { "$ref": "#/$defs/coverage" },
      "diagnostics": {
        "type": "array",
        "maxItems": 200000,
        "items": { "type": "object", "additionalProperties": true }
      },
      "limitations": {
        "type": "array",
        "maxItems": 128,
        "items": { "type": "string", "maxLength": 4096 }
      }
    },
    "$defs": {
      "sourceRow": {
        "type": "object",
        "maxProperties": 128,
        "additionalProperties": true
      },
      "sourceContext": {
        "type": "object",
        "maxProperties": 6,
        "properties": {
          "source_evidence": {},
          "source_evidence_id": {},
          "evidence": {},
          "artifact_sha256": {},
          "artifact_path": {},
          "source": {}
        },
        "additionalProperties": false
      },
      "factSources": {
        "type": "array",
        "maxItems": 2,
        "uniqueItems": true,
        "items": { "enum": ["metadata", "binary"] }
      },
      "index": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "classLayout": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type_index", "type", "parent_type", "fields", "sources", "layout", "status"],
        "properties": {
          "type_index": { "$ref": "#/$defs/index" },
          "type": { "$ref": "#/$defs/sourceRow" },
          "parent_type": {},
          "fields": {
            "type": "array",
            "maxItems": 200000,
            "items": { "$ref": "#/$defs/classField" }
          },
          "sources": { "$ref": "#/$defs/sourceContext" },
          "layout": { "$ref": "#/$defs/classLayoutFacts" },
          "status": { "enum": ["complete", "partial"] }
        }
      },
      "classField": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_index", "field", "layout", "facts", "sources", "status"],
        "properties": {
          "field_index": { "$ref": "#/$defs/index" },
          "field": { "anyOf": [{ "$ref": "#/$defs/sourceRow" }, { "type": "null" }] },
          "layout": { "anyOf": [{ "$ref": "#/$defs/layoutFact" }, { "type": "null" }] },
          "facts": { "$ref": "#/$defs/fieldFacts" },
          "sources": { "$ref": "#/$defs/sourceBundle" },
          "status": { "enum": ["mapped", "unknown", "unmapped"] }
        }
      },
      "fieldFacts": {
        "type": "object",
        "additionalProperties": false,
        "required": ["size", "size_source", "size_sources", "alignment", "alignment_source", "alignment_sources"],
        "properties": {
          "size": { "anyOf": [{ "$ref": "#/$defs/index" }, { "type": "null" }] },
          "size_source": { "enum": ["observed", "unknown", "contradictory"] },
          "size_sources": { "$ref": "#/$defs/factSources" },
          "alignment": { "anyOf": [{ "$ref": "#/$defs/index" }, { "type": "null" }] },
          "alignment_source": { "enum": ["observed", "unknown", "contradictory"] },
          "alignment_sources": { "$ref": "#/$defs/factSources" }
        }
      },
      "sourceBundle": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metadata", "binary"],
        "properties": {
          "metadata": { "$ref": "#/$defs/sourceContext" },
          "binary": { "$ref": "#/$defs/sourceContext" }
        }
      },
      "layoutFact": {
        "type": "object",
        "maxProperties": 128,
        "additionalProperties": true
      },
      "classLayoutFacts": {
        "type": "object",
        "additionalProperties": false,
        "required": ["size", "size_source", "alignment", "alignment_source", "alignment_sources", "overlap_count"],
        "properties": {
          "size": { "anyOf": [{ "$ref": "#/$defs/index" }, { "type": "null" }] },
          "size_source": { "enum": ["observed", "inferred_from_field_ends", "unknown", "contradictory"] },
          "alignment": { "anyOf": [{ "$ref": "#/$defs/index" }, { "type": "null" }] },
          "alignment_source": { "enum": ["observed", "unknown", "contradictory"] },
          "alignment_sources": { "$ref": "#/$defs/factSources" },
          "overlap_count": { "$ref": "#/$defs/index" }
        }
      },
      "coverage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type_rows", "field_rows", "layout_rows", "mapped_fields", "unknown_fields", "unmapped_fields", "contradictory_facts", "unknown_facts", "unresolved_owners"],
        "properties": {
          "type_rows": { "$ref": "#/$defs/index" },
          "field_rows": { "$ref": "#/$defs/index" },
          "layout_rows": { "$ref": "#/$defs/index" },
          "mapped_fields": { "$ref": "#/$defs/index" },
          "unknown_fields": { "$ref": "#/$defs/index" },
          "unmapped_fields": { "$ref": "#/$defs/index" },
          "contradictory_facts": { "$ref": "#/$defs/index" },
          "unknown_facts": { "$ref": "#/$defs/index" },
          "unresolved_owners": { "$ref": "#/$defs/index" }
        }
      }
    }
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  }
}
