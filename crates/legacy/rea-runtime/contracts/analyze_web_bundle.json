{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "analyze_web_bundle",
  "title": "Analyze web bundle",
  "description": "Capture JavaScript source from one selected CDP page and statically derive bundle relationships without executing the captured application.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["cdp_endpoint", "target_id"],
    "properties": {
      "cdp_endpoint": {"type": "string", "minLength": 1},
      "allowed_origins": {"type": "array", "items": {"type": "string"}, "default": []},
      "target_id": {"type": "string", "minLength": 1},
      "observation_ms": {"type": "integer", "minimum": 0, "default": 500},
      "include_script_sources": {"type": "boolean", "default": true},
      "include_accessibility_text": {"type": "boolean", "default": false},
      "include_console_text": {"type": "boolean", "default": false},
      "include_json_body_shapes": {"type": "boolean", "default": false},
      "include_websocket_shapes": {"type": "boolean", "default": false},
      "include_storage_keys": {"type": "boolean", "default": false},
      "include_storage_fingerprints": {"type": "boolean", "default": false},
      "fetch_source_maps": {"type": "boolean", "default": false},
      "max_heap_mb": {"type": "integer", "minimum": 128, "maximum": 16384},
      "analysis_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 2147483647},
      "total_analysis_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 2147483647}
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["result"],
    "properties": {"result": {"type": "object"}}
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  }
}
