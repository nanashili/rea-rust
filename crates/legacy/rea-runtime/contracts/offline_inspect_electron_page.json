{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "offline_inspect_electron_page",
  "title": "Inspect Electron page evidence from a supplied capture.",
  "description": "Inspect Electron page evidence from a supplied capture. This contract accepts only an explicit retained value and never contacts or launches a target.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "capture"
    ],
    "properties": {
      "capture": {
        "type": "object",
        "description": "retained Electron page capture"
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "result"
    ],
    "properties": {
      "result": {
        "type": "object"
      }
    }
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  }
}
