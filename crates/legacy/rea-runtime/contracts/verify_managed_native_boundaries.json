{
  "name": "verify_managed_native_boundaries",
  "title": "Verify Managed Native Boundaries",
  "description": "Compare caller-supplied managed P/Invoke declarations with caller-supplied native Evidence without executing managed or native code or translating managed tokens into addresses.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "managed_boundaries": { "type": "object", "minProperties": 1 },
      "native_observations": { "type": "array", "minItems": 1, "items": { "type": "object", "minProperties": 1 } }
    },
    "required": ["managed_boundaries", "native_observations"]
  },
  "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["result"], "properties": { "result": { "type": "object" } }, "additionalProperties": false },
  "annotations": { "destructiveHint": false, "idempotentHint": true, "openWorldHint": false, "readOnlyHint": true }
}
