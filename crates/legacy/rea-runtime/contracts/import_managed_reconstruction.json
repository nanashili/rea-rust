{
  "name": "import_managed_reconstruction",
  "title": "Import Managed Reconstruction",
  "description": "Import caller-supplied decompiler reconstruction text against authenticated managed member Evidence, preserving artifact, MVID, token, signature, and normalized-IL provenance.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "static_members": { "type": "object", "minProperties": 1 },
      "decompiler": { "type": "object", "minProperties": 1 },
      "methods": { "type": "array", "minItems": 1, "items": { "type": "object", "minProperties": 1 } },
      "notes": { "type": "array", "items": {} }
    },
    "required": ["static_members", "decompiler", "methods"]
  },
  "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["result"], "properties": { "result": { "type": "object" } }, "additionalProperties": false },
  "annotations": { "destructiveHint": false, "idempotentHint": true, "openWorldHint": false, "readOnlyHint": true }
}
