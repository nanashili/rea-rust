{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "trace_feature",
  "title": "Trace native feature",
  "description": "Match a literal query across retained string, procedure, and xref observations while preserving evidence links and residual unknowns.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["query"],
    "properties": {
      "query": {"type": "string", "minLength": 1, "maxLength": 16384},
      "case_sensitive": {"type": "boolean", "default": false},
      "observations": {"type": "array", "items": {"type": "object"}},
      "application": {"type": "object"}
    }
  },
  "outputSchema": {"type": "object"},
  "annotations": {"destructiveHint": false, "idempotentHint": true, "openWorldHint": false, "readOnlyHint": true}
}
