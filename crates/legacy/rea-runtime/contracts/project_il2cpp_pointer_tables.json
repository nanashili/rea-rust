{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "project_il2cpp_pointer_tables",
  "title": "Project IL2CPP Pointer Tables",
  "description": "Project caller-supplied IL2CPP CodeGenModule method-pointer tables. This bounded operation is read-only and captured-only; it does not read files, invoke providers, attach to a process, execute target code, or mutate a target.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["modules"],
    "properties": {
      "modules": { "$ref": "#/$defs/modules" },
      "codegen_modules": { "$ref": "#/$defs/modules" },
      "method_pointer_modules": { "$ref": "#/$defs/modules" },
      "executable_ranges": { "$ref": "#/$defs/ranges" },
      "executableRanges": { "$ref": "#/$defs/ranges" }
    },
    "$defs": {
      "modules": {
        "type": "array",
        "maxItems": 200000,
        "items": { "$ref": "#/$defs/module" }
      },
      "module": {
        "type": "object",
        "additionalProperties": true,
        "required": ["method_pointers"],
        "properties": {
          "module_name": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1 },
          "image_index": { "$ref": "#/$defs/u64" },
          "image_id": { "$ref": "#/$defs/u64" },
          "image_name": { "type": "string", "minLength": 1 },
          "assembly_name": { "type": "string", "minLength": 1 },
          "image": { "type": "string", "minLength": 1 },
          "method_pointer_count": { "$ref": "#/$defs/u64" },
          "methodPointerCount": { "$ref": "#/$defs/u64" },
          "method_pointers": { "$ref": "#/$defs/pointers" },
          "method_pointer_rows": { "$ref": "#/$defs/pointers" }
        }
      },
      "pointers": {
        "type": "array",
        "maxItems": 200000,
        "items": {
          "anyOf": [
            { "$ref": "#/$defs/u64OrNull" },
            { "$ref": "#/$defs/pointer" }
          ]
        }
      },
      "pointer": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "slot": { "$ref": "#/$defs/u64" },
          "address": { "$ref": "#/$defs/u64OrNull" }
        }
      },
      "ranges": {
        "type": "array",
        "maxItems": 200000,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/u64" },
            "end": { "$ref": "#/$defs/u64" }
          }
        }
      },
      "u64": {
        "anyOf": [
          { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          { "type": "string", "pattern": "^(0[xX][0-9a-fA-F]+|[0-9]+)$" }
        ]
      },
      "u64OrNull": {
        "anyOf": [ { "$ref": "#/$defs/u64" }, { "type": "null" } ]
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["operation", "modules", "executable_ranges", "coverage"],
    "properties": {
      "operation": { "const": "project_il2cpp_pointer_tables" },
      "modules": { "type": "array", "maxItems": 200000, "items": { "type": "object" } },
      "executable_ranges": { "$ref": "#/inputSchema/$defs/ranges" },
      "coverage": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
    }
  },
  "readOnlyHint": true,
  "idempotentHint": true,
  "openWorldHint": false
}
