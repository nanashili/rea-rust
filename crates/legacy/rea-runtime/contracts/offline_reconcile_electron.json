{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "reconcile_electron",
  "title": "Reconcile supplied Electron static and runtime Evidence.",
  "description": "Reconcile supplied Electron static and runtime Evidence. This contract has no browser, Electron, process, filesystem, endpoint, or JavaScript authority.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "static_evidence",
      "runtime_evidence"
    ],
    "properties": {
      "static_evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object"
        }
      },
      "runtime_evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object"
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "result"
    ],
    "properties": {
      "result": {
        "type": "object"
      }
    }
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  }
}
