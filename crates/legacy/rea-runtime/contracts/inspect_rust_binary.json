      "path": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\x00]*$",
        "description": "Absolute filesystem path to the selected executable or library"
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "path": "/artifacts/application"
      }
    ]
  },
