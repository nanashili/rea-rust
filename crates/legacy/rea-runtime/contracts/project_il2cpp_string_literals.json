        },
        "oneOf": [
          { "required": ["offset", "end"], "properties": { "offset": {}, "end": {} }, "not": { "required": ["intersection"], "properties": { "intersection": {} } } },
          { "required": ["intersection"], "properties": { "intersection": {} }, "not": { "required": ["offset"], "properties": { "offset": {} } } }
        ]
      }
    }
  },
