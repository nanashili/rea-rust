        "minimum": 0,
        "maximum": 9007199254740991
      },
      "data": {
        "type": "string",
        "contentEncoding": "base64",
        "maxLength": 357913944
      },
      "rows": {
        "type": "array",
        "maxItems": 200000,
        "items": {}
      },
      "rowFields": {
        "type": "object",
        "additionalProperties": false,
