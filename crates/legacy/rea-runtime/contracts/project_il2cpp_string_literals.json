        "oneOf": [
          { "required": ["data_base64"], "properties": { "data_base64": {} } },
          { "required": ["literal_data_base64"], "properties": { "literal_data_base64": {} } },
          { "required": ["string_literal_data_base64"], "properties": { "string_literal_data_base64": {} } },
          { "required": ["stringLiteralDataBase64"], "properties": { "stringLiteralDataBase64": {} } },
          { "required": ["bytes_base64"], "properties": { "bytes_base64": {} } }
        ]
      },
      "rootInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "literals": { "$ref": "#/$defs/rows" },
          "string_literals": { "$ref": "#/$defs/rows" },
          "string_literal_rows": { "$ref": "#/$defs/rows" },
          "stringLiteralRows": { "$ref": "#/$defs/rows" },
          "stringLiterals": { "$ref": "#/$defs/rows" },
          "data_base64": { "$ref": "#/$defs/data" },
          "literal_data_base64": { "$ref": "#/$defs/data" },
          "string_literal_data_base64": { "$ref": "#/$defs/data" },
          "stringLiteralDataBase64": { "$ref": "#/$defs/data" },
          "bytes_base64": { "$ref": "#/$defs/data" },
          "metadata": { "$ref": "#/$defs/rowFields" },
          "binary": { "$ref": "#/$defs/dataFields" }
        },
        "allOf": [
          {
            "anyOf": [
              { "required": ["literals"], "properties": { "literals": {} } },
              { "required": ["string_literals"], "properties": { "string_literals": {} } },
              { "required": ["string_literal_rows"], "properties": { "string_literal_rows": {} } },
              { "required": ["stringLiteralRows"], "properties": { "stringLiteralRows": {} } },
