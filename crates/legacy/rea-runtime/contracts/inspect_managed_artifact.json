{
  "name": "inspect_managed_artifact",
  "title": "Inspect Managed Artifact",
  "description": "Inspect caller-supplied managed PE/CLI bytes or authenticated retained managed Evidence without opening a path, executing target code, or mutating the artifact.",
  "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["path", "bytes_base64"], "properties": { "path": { "type": "string", "minLength": 1 }, "bytes_base64": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    { "type": "object", "additionalProperties": false, "required": ["evidence"], "properties": { "evidence": { "type": "object", "minProperties": 1 } } },
    { "type": "object", "additionalProperties": false, "required": ["result"], "properties": { "result": { "type": "object", "minProperties": 1 }, "evidence_id": { "type": ["string", "null"] } } },
    { "type": "object", "additionalProperties": false, "required": ["normalized_result"], "properties": { "normalized_result": { "type": "object", "minProperties": 1 }, "evidence_id": { "type": ["string", "null"] } } }
  ] },
  "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["result", "provenance"], "properties": { "result": { "type": "object" }, "evidence_id": { "type": ["string", "null"] }, "provenance": { "type": "object" } }, "additionalProperties": false },
  "annotations": { "destructiveHint": false, "idempotentHint": true, "openWorldHint": false, "readOnlyHint": true }
}
