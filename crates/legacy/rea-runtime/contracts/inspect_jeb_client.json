{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "inspect_jeb_client",
  "title": "Inspect JEB Client",
  "description": "Project caller-captured JEB client information into the public client observation. This contract never contacts or launches JEB.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "oneOf": [
      {
        "required": ["selection", "client_information"],
        "properties": {
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["endpoint"],
            "properties": {
              "endpoint": {
                "type": "string",
                "minLength": 1,
                "description": "Caller-selected loopback JEB MCP endpoint."
              }
            }
          },
          "client_information": {
            "type": "object",
            "required": ["success"],
            "properties": {
              "success": {"type": "boolean"},
              "version": {"type": ["string", "null"]},
              "gui_client": {"type": ["boolean", "null"]},
              "startup_ts": {
                "type": ["integer", "null"],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "message": {"type": ["string", "null"]},
              "error": {"type": "object"}
            },
            "description": "Captured `get_client_information` response. Provider fields not understood by REA are retained at the capture boundary."
          }
        }
      },
      {
        "required": ["evidence"],
        "properties": {
          "evidence": {
            "type": "object",
            "description": "Authenticated retained inspect_jeb_client Evidence."
          }
        }
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["engine", "startup_ts", "message"],
    "properties": {
      "engine": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "endpoint", "gui_client"],
        "properties": {
          "name": {"const": "jeb"},
          "version": {"type": ["string", "null"]},
          "endpoint": {"type": "string", "minLength": 1},
          "gui_client": {"type": ["boolean", "null"]}
        }
      },
      "startup_ts": {
        "type": ["integer", "null"],
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "message": {"type": ["string", "null"]}
    }
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  }
}
