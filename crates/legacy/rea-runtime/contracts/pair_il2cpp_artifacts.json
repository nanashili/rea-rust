{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "pair_il2cpp_artifacts",
  "title": "Pair IL2CPP Artifacts",
  "description": "Correlate caller-supplied IL2CPP metadata, native, and managed artifact captures by exact target/build identity, architecture, and SHA-256. This operation is bounded, read-only, static/captured only, and preserves unresolved and ambiguous relationships.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "oneOf": [
      {
        "required": ["artifacts"],
        "properties": {
          "artifacts": { "$ref": "#/$defs/artifacts" }
        }
      },
      {
        "required": ["evidence"],
        "properties": {
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      },
      {
        "required": ["artifacts", "evidence"],
        "properties": {
          "artifacts": { "$ref": "#/$defs/artifacts" },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    ],
    "$defs": {
      "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "artifact": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["metadata", "native", "managed"] },
          "target_id": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "bundle_id": { "type": "string", "minLength": 1 },
          "build_id": { "type": "string", "minLength": 1 },
          "build": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "architecture": { "type": "string", "minLength": 1 },
          "arch": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "digest": { "$ref": "#/$defs/sha256" }
        }
      },
      "artifacts": {
        "type": "array",
        "maxItems": 1024,
        "items": { "$ref": "#/$defs/artifact" }
      },
      "evidence": {
        "type": "array",
        "maxItems": 1024,
        "items": {
          "type": "object",
          "required": ["evidence_id", "operation", "normalized_result"],
          "properties": {
            "evidence_id": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" },
            "operation": { "type": "string", "minLength": 1 },
            "normalized_result": { "type": "object" }
          },
          "additionalProperties": true
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["status", "pairs", "ungrouped", "coverage"],
    "properties": {
      "status": { "enum": ["complete", "partial"] },
      "pairs": {
        "type": "array",
        "maxItems": 1024,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "status", "metadata", "native", "managed", "ambiguity"],
          "properties": {
            "identity": { "$ref": "#/$defs/identity" },
            "status": { "enum": ["paired", "unresolved", "ambiguous"] },
            "metadata": { "$ref": "#/$defs/artifacts" },
            "native": { "$ref": "#/$defs/artifacts" },
            "managed": { "$ref": "#/$defs/artifacts" },
            "ambiguity": { "type": ["string", "null"] }
          }
        }
      },
      "ungrouped": { "type": "array", "maxItems": 1024, "items": { "type": "object" } },
      "coverage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifacts", "pairs", "ungrouped"],
        "properties": {
          "artifacts": { "type": "integer", "minimum": 0, "maximum": 1024 },
          "pairs": { "type": "integer", "minimum": 0, "maximum": 1024 },
          "ungrouped": { "type": "integer", "minimum": 0, "maximum": 1024 }
        }
      }
    },
    "$defs": {
      "identity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "build_id", "architecture", "sha256"],
        "properties": {
          "target_id": { "type": "string" },
          "build_id": { "type": "string" },
          "architecture": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "artifact": {
        "type": "object",
        "additionalProperties": true
      },
      "artifacts": {
        "type": "array",
        "maxItems": 1024,
        "items": { "$ref": "#/$defs/artifact" }
      }
    }
  },
  "readOnlyHint": true,
  "idempotentHint": true,
  "openWorldHint": false
}
