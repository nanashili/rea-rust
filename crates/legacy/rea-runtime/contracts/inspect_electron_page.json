{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "inspect_electron_page",
  "title": "Inspect Electron page",
  "description": "Passively inspect one Electron file page by supplying its loopback CDP endpoint and target ID. The provider rechecks that the target currently exists at that endpoint and is a local file page. Returns frames, DOM structure, resource paths, and scripts without evaluating renderer JavaScript or invoking Electron APIs. The selected endpoint exposes every local file page and its metadata to this tool.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Provide a complete input group: cdp_endpoint + target_id + [observation_ms] + [include_script_sources]; cdp_endpoint + target_id + include_script_sources + [observation_ms].",
    "examples": [
      {
        "cdp_endpoint": "http://127.0.0.1:9223",
        "target_id": "TARGET_ID_FROM_LIST_ELECTRON_TARGETS"
      }
    ],
    "minProperties": 2,
    "properties": {
      "cdp_endpoint": {
        "description": "Literal loopback Chrome DevTools Protocol endpoint.",
        "minLength": 1,
        "type": "string"
      },
      "include_script_sources": {
        "default": false,
        "description": "Whether to include script sources in the result.",
        "type": "boolean"
      },
      "observation_ms": {
        "default": 100,
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "target_id": {
        "description": "Exact CDP target identifier selected from the endpoint's target listing.",
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "cdp_endpoint",
      "target_id"
    ],
    "type": "object"
  },
