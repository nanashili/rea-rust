{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "inspect_web_page",
  "title": "Inspect web page",
  "description": "Passively inspect one caller-selected browser page through CDP while preserving origin scope, output switches, and bounded observation time.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["cdp_endpoint", "target_id"],
    "properties": {
      "cdp_endpoint": {"type": "string", "minLength": 1},
      "allowed_origins": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
      "target_id": {"type": "string", "minLength": 1},
      "observation_ms": {"type": "integer", "minimum": 0, "maximum": 2147483647, "default": 500},
      "include_accessibility_text": {"type": "boolean", "default": false},
      "include_console_text": {"type": "boolean", "default": false},
      "include_json_body_shapes": {"type": "boolean", "default": false},
      "include_script_sources": {"type": "boolean", "default": false},
      "include_websocket_shapes": {"type": "boolean", "default": false},
      "include_storage_keys": {"type": "boolean", "default": false},
      "include_storage_fingerprints": {"type": "boolean", "default": false}
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["result"],
    "properties": {"result": {"type": "object"}}
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  }
}
