{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "inspect_web_event_listeners",
  "title": "Inspect web event listeners",
  "description": "Inspect listeners directly attached to the first main-document CSS match through a caller-selected passive CDP page.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["cdp_endpoint", "target_id", "selector"],
    "properties": {
      "cdp_endpoint": {"type": "string", "minLength": 1},
      "allowed_origins": {"type": "array", "items": {"type": "string"}, "default": []},
      "target_id": {"type": "string", "minLength": 1},
      "selector": {"type": "string", "minLength": 1}
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["result"],
    "properties": {"result": {"type": "object"}}
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
  }
}
