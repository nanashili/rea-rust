{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "reconcile_javascript_runtime",
  "title": "Reconcile JavaScript runtime Evidence",
  "description": "Reconcile one application static graph with one or more passive runtime Evidence records while preserving ambiguity and incomplete coverage.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["static_layers", "runtime_observations"],
    "properties": {
      "static_layers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
      "runtime_observations": {"type": "array", "minItems": 1, "items": {"type": "object"}}
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["result"],
    "properties": {"result": {"type": "object"}}
  },
  "annotations": {"destructiveHint": false, "idempotentHint": true, "openWorldHint": false, "readOnlyHint": true}
}
