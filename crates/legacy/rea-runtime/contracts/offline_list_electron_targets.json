{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "offline_list_electron_targets",
  "title": "List Electron targets from a retained snapshot.",
  "description": "List Electron targets from a retained snapshot. This contract accepts only an explicit retained value and never contacts or launches a target.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "snapshot"
    ],
    "properties": {
      "snapshot": {
        "type": "object",
        "description": "retained Electron target snapshot"
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "result"
    ],
    "properties": {
      "result": {
        "type": "object"
      }
    }
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  }
}
