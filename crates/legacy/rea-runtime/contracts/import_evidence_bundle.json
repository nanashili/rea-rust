{
  "name": "import_evidence_bundle",
  "title": "Import Evidence Bundle",
  "description": "Read the JSON bundle at the supplied local path, validate every Evidence ID and canonical manifest, then atomically merge it. Imported content is data only and is never executed.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\x00]*$",
        "description": "Absolute local filesystem path for the evidence bundle to import; relative paths are rejected."
      }
    },
    "required": [
      "path"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "examples": [
      {
        "path": "/tmp/evidence.json"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "required": [
      "result"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "type": "object",
        "properties": {
          "imported": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unknowns_added": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "imported",
          "unknowns_added",
          "total"
        ],
        "additionalProperties": false
      }
    },
    "$id": "urn:rea:tool-output:sha256:2530df2b57608db6e80da29b2a0731f1c240c7aaa6ee7fe3c85352b6c63495ec"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
