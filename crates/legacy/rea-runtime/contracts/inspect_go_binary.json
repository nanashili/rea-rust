    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "description": "Absolute filesystem path to the selected executable or library"
          }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^[^\\x00]*$" },
          "bytes_base64": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "required": ["path", "bytes_base64"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "evidence": { "type": "object", "minProperties": 1 }
        },
        "required": ["evidence"],
        "additionalProperties": false
      }
    ],
    "examples": [
      { "path": "/artifacts/application" },
      { "path": "/captures/application", "bytes_base64": "AA==" }
    ]
  },
