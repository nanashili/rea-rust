{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "trace_native_values",
  "title": "Trace native values",
  "description": "Compose a bounded native def-use graph from retained analyze_function and resolve_native_call_targets Evidence. Missing bindings, aliases, and provider value-flow gaps remain unknown.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["procedure", "functions"],
    "properties": {
      "procedure": {"type": "string", "minLength": 1},
      "functions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object"}},
      "call_targets": {"type": "array", "items": {"type": "object"}},
      "max_depth": {"type": "integer", "minimum": 0, "maximum": 16, "default": 3},
      "max_functions": {"type": "integer", "minimum": 1, "maximum": 64, "default": 16},
      "max_call_sites": {"type": "integer", "minimum": 1, "maximum": 4096, "default": 256},
      "max_nodes": {"type": "integer", "minimum": 1, "maximum": 20000, "default": 5000},
      "max_edges": {"type": "integer", "minimum": 1, "maximum": 40000, "default": 10000},
      "offset": {"type": "integer", "minimum": 0, "default": 0},
      "limit": {"type": "integer", "minimum": 1, "maximum": 5000, "default": 1000}
    }
  },
  "outputSchema": {"type": "object"},
  "annotations": {"destructiveHint": false, "idempotentHint": true, "openWorldHint": false, "readOnlyHint": true}
}
