{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "search_strings",
  "title": "Search Captured Strings",
  "description": "Apply a bounded literal or supported regex predicate to retained string observations without rereading target bytes. A document selector matches the retained Evidence document identity.",
  "inputSchema": { "type": "object", "additionalProperties": false, "required": ["pattern"], "properties": { "pattern": { "type": "string", "minLength": 1, "maxLength": 16384 }, "mode": { "enum": ["literal", "regex"], "default": "literal" }, "case_sensitive": { "type": "boolean", "default": false }, "document": { "type": "string" }, "strings": { "type": "array", "maxItems": 200000 }, "inventory": { "type": "array", "maxItems": 200000 }, "evidence": { "type": "object" } } },
  "outputSchema": { "type": "array", "items": { "type": "object", "required": ["address", "value"], "properties": { "address": { "type": "string" }, "value": { "type": "string" }, "provider_value": { "type": "string" }, "decoding": { "type": "object" }, "string": { "type": "object" } }, "additionalProperties": false } },
  "annotations": { "destructiveHint": false, "idempotentHint": true, "openWorldHint": false, "readOnlyHint": true }
}
