        "additionalProperties": false
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "evidence_id": { "type": "string" },
      "operation": { "const": "inspect_evm_interface" },
