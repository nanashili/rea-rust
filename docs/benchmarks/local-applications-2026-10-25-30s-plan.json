{
  "schema_version": 1,
  "plan_id": "local-applications-2026-10-25",
  "status": "qualified",
  "purpose": "Read-only benchmark workflows for installed macOS applications and representative static artifacts.",
  "authority": "shipped-artifact",
  "host_scope": {
    "platform": "macos",
    "architecture": "arm64",
    "application_roots": [
      "/Applications",
      "/System/Applications"
    ],
    "target_policy": "Read application files and REA-owned cache only. Do not launch, attach to, mutate, sign, save, or close a target application."
  },
  "measurement_contract": {
    "samples_per_case": 5,
    "order": "Sequential workflows; reverse workflow order in even rounds; five fresh process samples per workflow.",
    "per_case_timeout_seconds": 120,
    "family_memory_limit_mib": 4096,
    "metrics": [
      "wall_time_ms",
      "wait4_user_cpu_ms",
      "wait4_system_cpu_ms",
      "wait4_maxrss_bytes",
      "sampled_family_peak_rss_bytes",
      "sampled_family_cpu_ms",
      "sampled_family_max_processes",
      "sampled_max_gap_ms",
      "output_bytes",
      "wait4_minor_faults",
      "wait4_major_faults",
      "wait4_block_input_operations",
      "wait4_block_output_operations",
      "wait4_voluntary_context_switches",
      "wait4_involuntary_context_switches",
      "harness_cpu_ms",
      "result_status",
      "response_sha256"
    ],
    "cache_states": [
      "fresh_process_and_isolated_REA_provider_cache_every_round",
      "retained_session_repeated_calls_when_repeat_is_set",
      "uncontrolled_OS_filesystem_cache_warmed_by_qualification_and_provenance_hashing"
    ],
    "provenance": [
      "target_path",
      "target_version",
      "target_architecture",
      "target_size_bytes",
      "selected_artifact_sha256",
      "rea_executable_sha256",
      "catalog_sha256",
      "host_os_build",
      "toolchain_versions",
      "harness_revision"
    ],
    "unmeasured": [
      "actual_agent_tokens",
      "energy",
      "physical_disk_bytes",
      "CPU_hardware_counters",
      "standalone_provider_startup",
      "full_application_correctness"
    ],
    "sample_interval_seconds": 0.005
  },
  "workflows": [
    {
