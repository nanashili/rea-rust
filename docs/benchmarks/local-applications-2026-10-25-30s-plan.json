            "path": "/System/Applications/Utilities/Terminal.app",
            "detail": "summary",
            "max_entries": 2000,
            "max_probe_bytes": 1048576
          }
        },
        {
          "name": "open_binary",
          "arguments": {
            "path": "/System/Applications/Utilities/Terminal.app",
            "provider_id": "ghidra-rust"
          }
        },
        {
          "name": "close_binary",
          "arguments": {}
        }
      ]
    },
